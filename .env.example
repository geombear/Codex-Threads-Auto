# Node 24 LTS. 복사하여 .env로 저장하세요. 비밀값을 Git에 넣지 마세요.
HOST=127.0.0.1
PORT=4310
APP_URL=http://127.0.0.1:4310
# 상시 서버용 PostgreSQL (비워두면 data/의 내장 PostgreSQL 사용)
DATABASE_URL=
# 서버 배포 시 32바이트 base64 암호화 키를 별도 비밀 저장소에서 공급
ENCRYPTION_KEY=
# 실제 발행은 이 값과 계정별 실제 게시 허용을 모두 켜야 합니다.
ALLOW_LIVE_PUBLISH=false
TRUST_PROXY=false
# 공식 Codex CLI 경로 (ChatGPT 구독 로그인). PATH에서 찾을 수 있으면 생략.
CODEX_BINARY=

# GEOM / KYU 공통 Gemini API 키. 모델 ID는 자동 선택합니다.
GEMINI_API_KEY=
# GPT는 공통 ChatGPT 구독 로그인(codex login)을 사용합니다. OpenAI API 키 불필요.
